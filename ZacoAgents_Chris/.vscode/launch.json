{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (local, breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["zaco.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "WORKBOOK_DIR": "${workspaceFolder}/.local/workbook", "BACKUP_DIR": "${workspaceFolder}/.local/backups" },
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: whole suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-vv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Attach to the compose app",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "/app" }],
      "justMyCode": false
    }
  ]
}
