# Default: let git normalise text in the repository.
* text=auto

# These run inside a Linux container. CRLF would make `#!/bin/sh\r` not an interpreter, and it
# is easy to reintroduce by editing on Windows, so pin them.
*.sh            text eol=lf
Dockerfile      text eol=lf
entrypoint.sh   text eol=lf
docker-compose.yml text eol=lf
render.yaml     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# The exports in data/ are fixtures. Their exact bytes -- CRLF, a BOM, U+00A0 separators --
# are the thing under test, so git must not touch them.
data/**         -text

# Same for the hand-made files in PersonalTest/: one carries a BOM and CRLF, another carries
# U+00A0 thousands separators, and normalising either would quietly disarm the case it exists
# to demonstrate. The README beside them is ordinary text.
ZacoAgents_Chris/PersonalTest/**        -text
ZacoAgents_Chris/PersonalTest/README.md text
workbook/*.xlsx binary
*.xlsx          binary
