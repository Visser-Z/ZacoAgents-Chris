# Copy to .env for local work. `docker compose up` supplies its own values for the app
# container; this file is for running uvicorn or pytest directly on the host.
#
# Switching to hosted means filling these same names into the provider's environment group.
# There is no other configuration anywhere (D3).

# --- Durable record -------------------------------------------------------------------------
# Hosting providers hand out postgres:// URLs; Settings normalises those automatically.
# 127.0.0.1 rather than localhost: on Windows `localhost` resolves to ::1 first, Docker
# publishes on IPv4 only, and every connection stalls on the IPv6 attempt before falling back.
DATABASE_URL=postgresql+psycopg://zaco:zaco@127.0.0.1:5432/zaco

# --- The operator's workbook and its snapshots ----------------------------------------------
# A named volume under compose, a mounted disk when hosted. Snapshots are written inside the
# append transaction, so both paths must be on storage that survives a restart (D4).
WORKBOOK_DIR=./.local/workbook
BACKUP_DIR=./.local/backups
BACKUP_RETENTION=50

# --- Sessions -------------------------------------------------------------------------------
# MUST be changed before hosting. While this is the shipped default the app warns on startup,
# says so on /api/health, and does not mark the session cookie Secure.
SECRET_KEY=dev-only-not-a-secret
SESSION_MAX_AGE=43200
# Leave unset to decide from the request scheme: no Secure flag over plain http locally,
# Secure when hosted behind TLS. Set to true or false only to override that.
# COOKIE_SECURE=

# --- The first account ----------------------------------------------------------------------
# Seeded once, on an empty database only. Never resets an existing password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Who may be invited ---------------------------------------------------------------------
# Optional, comma separated. Gates which addresses an admin may invite. It is never an
# identity: every person still gets their own account (D14). Empty means no restriction.
ALLOWED_EMAIL_DOMAINS=
